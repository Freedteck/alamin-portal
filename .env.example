# Backend Server Configuration
PORT=3000
JWT_SECRET="change-me-to-a-long-random-secret-in-production"

# Optional Server-Side Supabase PostgreSQL + Storage Persistence
# If omitted, the Express backend automatically persists data in local server storage (data/ & uploads/)
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Frontend API Endpoint URL
# Leave empty when serving frontend + backend from the same origin,
# or set to your deployed backend URL (e.g. https://api.alaminschools.edu) when deploying separately on Vercel.
VITE_API_BASE_URL=""
