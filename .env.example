# Backend Server Configuration
PORT=3000
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Required server-side Supabase PostgreSQL + private Storage configuration
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Optional initial administrator provisioning (no default account is created)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Required for password reset email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend API Endpoint URL
# Leave empty when serving frontend + backend from the same origin,
# or set to your deployed backend URL (e.g. https://api.alaminschools.edu) when deploying separately on Vercel.
VITE_API_BASE_URL=""
